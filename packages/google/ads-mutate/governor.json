{
  "spec_version": "korux_governor_v1",
  "capability_id": "google/ads-mutate",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "action",
      "campaign_id",
      "status",
      "budget_id",
      "amount_micros",
      "customer_id"
    ]
  },
  "rules": [
    {
      "id": "block_empty_campaign_id",
      "when": {
        "args.campaign_id": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "campaign_id is empty",
        "zh_CN": "campaign_id 为空",
        "zh_HK": "campaign_id 為空"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Google Ads mutate (spend-affecting) requires human approval",
        "zh_CN": "Google Ads 变更（影响花费）前须人工确认",
        "zh_HK": "Google Ads 變更（影響花費）前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
