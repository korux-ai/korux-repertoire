{
  "spec_version": "korux_capability_v1",
  "id": "google/ads-mutate",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Google Ads mutate",
  "label_i18n": {
    "en": "Google Ads mutate",
    "zh_CN": "Google 广告变更",
    "zh_HK": "Google 廣告變更"
  },
  "description": "Pause/enable a Google Ads campaign; optional campaign budget amount_micros with Owner cap — no removals, after Vault binding and Governor gate",
  "description_i18n": {
    "en": "Pause/enable a Google Ads campaign; optional budget with Owner cap — no removals, after Vault binding and Governor gate",
    "zh_CN": "暂停/启用 Google Ads 广告系列；可选预算（Owner 上限）——不可删除（需 Vault 与 Governor）",
    "zh_HK": "暫停/啟用 Google Ads 廣告系列；可選預算（Owner 上限）——不可刪除（需 Vault 與 Governor）"
  },
  "category": "ads",
  "reads_external": false,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "high",
  "produces_content": false,
  "propose_guide": "Spend-affecting write via Google Ads API REST. Prefer action=set_status with status=PAUSED. status=ENABLED and set_budget only when NL explicitly asks and Owner caps allow. Never REMOVED. Always require_human. Needs developer_token + OAuth + customer_id.",
  "propose_guide_i18n": {
    "en": "Spend-affecting write. Prefer set_status=PAUSED. ENABLED/set_budget only when NL asks and Owner caps allow. Never REMOVED. Always require_human.",
    "zh_CN": "影响花费的写入。优先暂停。启用/改预算仅当用户明确要求且未超 Owner 上限。禁止删除。必须人工确认。",
    "zh_HK": "影響花費的寫入。優先暫停。啟用/改預算僅當用戶明確要求且未超 Owner 上限。禁止刪除。必須人工確認。"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "action",
      "campaign_id"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "set_status",
          "set_budget"
        ]
      },
      "campaign_id": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "ENABLED",
          "PAUSED"
        ]
      },
      "budget_id": {
        "type": "string"
      },
      "amount_micros": {
        "type": "integer",
        "minimum": 10000,
        "description": "Budget in micros (1e6 = 1 currency unit)"
      },
      "customer_id": {
        "type": "string",
        "description": "Override Vault customer_id (digits only)"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "campaign_id": {
        "type": "string"
      },
      "action": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "amount_micros": {
        "type": "integer"
      },
      "content": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "action",
      "required": true,
      "sources": [
        "nl_fixed",
        "step_field"
      ],
      "description": "set_status or set_budget",
      "confirm_if_missing": true
    },
    {
      "name": "campaign_id",
      "required": true,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "Google Ads campaign id",
      "confirm_if_missing": true
    },
    {
      "name": "status",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field"
      ],
      "description": "ENABLED or PAUSED for set_status",
      "confirm_if_missing": false
    },
    {
      "name": "budget_id",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "Campaign budget id for set_budget",
      "confirm_if_missing": false
    },
    {
      "name": "amount_micros",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field"
      ],
      "description": "New budget amount_micros (Owner-capped)",
      "confirm_if_missing": false
    }
  ],
  "editable_governor_config": {
    "allow_enable": {
      "type": "boolean",
      "default": false,
      "label": "Allow status=ENABLED"
    },
    "allow_budget_change": {
      "type": "boolean",
      "default": false,
      "label": "Allow action=set_budget"
    },
    "max_amount_micros": {
      "type": "integer",
      "minimum": 10000,
      "default": 500000000,
      "label": "Max amount_micros (default 500 currency units)"
    }
  },
  "auth": {
    "required": true,
    "binding_tool": "google/ads-mutate",
    "secret_kind": "google-ads",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "access_token",
        "label": "OAuth access token",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "developer_token",
        "label": "Google Ads developer token",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "customer_id",
        "label": "Customer id (digits, no dashes)",
        "type": "text",
        "required": true
      },
      {
        "name": "login_customer_id",
        "label": "Manager login-customer-id (optional)",
        "type": "text",
        "required": false
      }
    ],
    "example_json": "{\"access_token\":\"ya29.xxx\",\"developer_token\":\"xxxx\",\"customer_id\":\"1234567890\"}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 45000,
    "idempotent": false
  },
  "invoke_tool": "google/ads-mutate",
  "binding_tool": "google/ads-mutate",
  "status": "beta",
  "trust": "first-party",
  "aliases": [
    "google-ads-mutate"
  ]
}
