{
  "spec_version": "korux_capability_v1",
  "id": "google/meet",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Google Meet",
  "label_i18n": {
    "en": "Google Meet",
    "zh_CN": "Google Meet",
    "zh_HK": "Google Meet"
  },
  "description": "Verify Google identity for Meet workflows via OAuth userinfo (or refresh token) after Vault binding",
  "description_i18n": {
    "en": "Verify Google identity for Meet workflows via OAuth userinfo after Vault binding",
    "zh_CN": "通过 OAuth userinfo 校验 Google 身份，供 Meet 相关工作流（需 Vault）",
    "zh_HK": "透過 OAuth userinfo 校驗 Google 身分，供 Meet 相關工作流（需 Vault）"
  },
  "category": "meeting",
  "reads_external": true,
  "writes_external": false,
  "boundary": "External",
  "default_gate": "auto",
  "risk": "low",
  "produces_content": false,
  "propose_guide": "Use when a workflow needs Google Meet identity binding. Pass optional meeting_id from monitor/trigger context. Does not create Meet conferences.",
  "propose_guide_i18n": {
    "en": "Use when a workflow needs Google Meet identity binding. Does not create Meet conferences.",
    "zh_CN": "工作流需要绑定 Google Meet 身份时使用。不创建会议。",
    "zh_HK": "工作流需要綁定 Google Meet 身分時使用。不建立會議。"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "meeting_id": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "provider": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "meeting_id": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "meeting_id",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "trigger"
      ],
      "description": "Optional meeting id for monitor context",
      "confirm_if_missing": false
    }
  ],
  "auth": {
    "required": true,
    "binding_tool": "google/meet",
    "secret_kind": "google-meet",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "access_token",
        "label": "OAuth access token",
        "type": "password",
        "required": false,
        "sensitive": true
      },
      {
        "name": "client_id",
        "label": "OAuth client ID",
        "type": "text",
        "required": false
      },
      {
        "name": "client_secret",
        "label": "OAuth client secret",
        "type": "password",
        "required": false,
        "sensitive": true
      },
      {
        "name": "refresh_token",
        "label": "OAuth refresh token",
        "type": "password",
        "required": false,
        "sensitive": true
      }
    ],
    "example_json": "{\"client_id\":\"xxxxx.apps.googleusercontent.com\",\"client_secret\":\"GOCSPX-xxxxx\",\"refresh_token\":\"1//xxxxx\"}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": true
  },
  "invoke_tool": "google/meet",
  "binding_tool": "google/meet",
  "status": "beta",
  "trust": "first-party",
  "aliases": [
    "google-meet"
  ],
  "editable_governor_config": {}
}
