{
  "spec_version": "korux_governor_v1",
  "capability_id": "alibaba/wanx-edit",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "prompt",
      "image_url",
      "model",
      "size",
      "n",
      "negative_prompt",
      "watermark"
    ]
  },
  "rules": [
    {
      "id": "block_empty_prompt",
      "when": {
        "args.prompt": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Edit prompt is empty",
        "zh_CN": "编辑提示词为空",
        "zh_HK": "編輯提示詞為空"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.prompt": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Prompt contains a blocked keyword",
        "zh_CN": "提示词包含禁止关键字",
        "zh_HK": "提示詞包含禁止關鍵字"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Alibaba Wanxiang image edit requires human approval",
        "zh_CN": "阿里万相图片编辑前须人工确认",
        "zh_HK": "阿里萬相圖片編輯前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
