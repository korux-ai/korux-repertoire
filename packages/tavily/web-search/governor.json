{
  "spec_version": "korux_governor_v1",
  "capability_id": "tavily/web-search",
  "capability_version": "1.1.0",
  "defaults": {
    "intercept_on_invoke": false,
    "editable_fields": [
      "query",
      "max_results"
    ]
  },
  "rules": [
    {
      "id": "block_denied_keywords",
      "when": {
        "args.query": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": "Search query matches an owner blocked keyword."
    },
    {
      "id": "reject_empty_query",
      "when": {
        "args.query": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": "搜索关键词为空；请在上游步骤提供查询文本"
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
