{
  "spec_version": "korux_capability_v1",
  "id": "notion/pages",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Notion",
  "description": "Create a Notion page (or database row) via Notion API after Vault binding and Governor gate",
  "category": "docs",
  "reads_external": true,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "medium",
  "produces_content": true,
  "propose_guide": "Write Notion after Internal extract/summarize. Title and body from upstream, not task NL verbatim.",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create_page",
          "create_database_item",
          "update_page"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 2000
      },
      "body": {
        "type": "string",
        "maxLength": 1900
      },
      "parent_page_id": {
        "type": "string"
      },
      "database_id": {
        "type": "string"
      },
      "page_id": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "page_id": {
        "type": "string"
      },
      "page_url": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "title",
      "required": false,
      "sources": [
        "upstream",
        "nl_fixed",
        "step_field"
      ],
      "description": "Page title",
      "confirm_if_missing": false
    },
    {
      "name": "body",
      "required": true,
      "sources": [
        "upstream",
        "step_field"
      ],
      "description": "Page body from upstream extract/summarize",
      "propose_hint": "Do not paste task NL as Notion body.",
      "confirm_if_missing": true
    }
  ],
  "auth": {
    "required": true,
    "binding_tool": "notion/pages",
    "secret_kind": "notion",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "token",
        "label": "Integration token",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "parent_page_id",
        "label": "Parent page id",
        "type": "text",
        "required": true
      },
      {
        "name": "database_id",
        "label": "Database id (optional)",
        "type": "text",
        "required": false
      }
    ]
  },
  "runtime": {
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": false
  },
  "invoke_tool": "notion/pages",
  "binding_tool": "notion/pages",
  "status": "stable",
  "trust": "first-party",
  "aliases": []
}
