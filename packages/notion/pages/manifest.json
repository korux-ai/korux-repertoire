{
  "spec_version": "korux_capability_v1",
  "id": "notion/pages",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Notion",
  "label_i18n": {
    "en": "Notion",
    "zh_CN": "Notion 页面",
    "zh_HK": "Notion 頁面"
  },
  "description": "Create a Notion page (or database row) via Notion API after Vault binding and Governor gate",
  "description_i18n": {
    "en": "Create a Notion page (or database row) via Notion API after Vault binding and Governor gate",
    "zh_CN": "通过 Notion API 创建页面（或数据库行；需 Vault 与 Governor）",
    "zh_HK": "透過 Notion API 建立頁面（或資料庫列；需 Vault 與 Governor）"
  },
  "category": "docs",
  "reads_external": true,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "medium",
  "produces_content": true,
  "propose_guide": "Write Notion after Internal extract/summarize. Title and body from upstream, not task NL verbatim.",
  "propose_guide_i18n": {
    "en": "Write Notion after Internal extract/summarize. Title and body from upstream, not task NL verbatim.",
    "zh_CN": "内部抽取/摘要后写入 Notion。标题与正文用上游产出，勿用任务原话。",
    "zh_HK": "內部抽取/摘要後寫入 Notion。標題與正文用上游產出，勿用任務原話。"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create_page",
          "create_database_item",
          "update_page"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 2000
      },
      "body": {
        "type": "string",
        "maxLength": 1900
      },
      "parent_page_id": {
        "type": "string"
      },
      "database_id": {
        "type": "string"
      },
      "page_id": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "page_id": {
        "type": "string"
      },
      "page_url": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "title",
      "required": false,
      "sources": [
        "upstream",
        "nl_fixed",
        "step_field"
      ],
      "description": "Page title",
      "confirm_if_missing": false
    },
    {
      "name": "body",
      "required": true,
      "sources": [
        "upstream",
        "step_field"
      ],
      "description": "Page body from upstream extract/summarize",
      "propose_hint": "Do not paste task NL as Notion body.",
      "confirm_if_missing": true
    }
  ],
  "auth": {
    "required": true,
    "binding_tool": "notion/pages",
    "secret_kind": "notion",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "token",
        "label": "Integration token",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "parent_page_id",
        "label": "Parent page id",
        "type": "text",
        "required": true
      },
      {
        "name": "database_id",
        "label": "Database id (optional)",
        "type": "text",
        "required": false
      }
    ]
  },
  "runtime": {
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": false
  },
  "invoke_tool": "notion/pages",
  "binding_tool": "notion/pages",
  "status": "stable",
  "trust": "first-party",
  "aliases": [],
  "editable_governor_config": {
    "min_body_length": {
      "type": "integer",
      "minimum": 1,
      "label": "Minimum body length",
      "description": "Reject when trimmed body is shorter than this length."
    },
    "require_title": {
      "type": "boolean",
      "default": false,
      "label": "Require title",
      "description": "Reject when title is empty."
    }
  }
}
