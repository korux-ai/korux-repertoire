{
  "spec_version": "korux_governor_v1",
  "capability_id": "notion/pages",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "title",
      "body"
    ]
  },
  "rules": [
    {
      "id": "block_empty_body",
      "when": {
        "args.body": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Notion body is empty; use upstream step output.",
        "zh_CN": "Notion 正文为空；须使用上游步骤产出",
        "zh_HK": "Notion 正文為空；須使用上游步驟產出"
      }
    },
    {
      "id": "block_short_body",
      "when": {
        "args.body": {
          "length_lt_owner": "min_body_length"
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Notion body shorter than owner min_body_length.",
        "zh_CN": "Notion 正文短于 Owner 设定的最小长度。",
        "zh_HK": "Notion 正文短於 Owner 設定的最小長度。"
      }
    },
    {
      "id": "block_empty_title",
      "when": {
        "args.title": {
          "empty_when_owner_true": "require_title"
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Notion title is empty.",
        "zh_CN": "Notion 标题为空。",
        "zh_HK": "Notion 標題為空。"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Human confirmation required before writing to Notion",
        "zh_CN": "写入 Notion 前须人工确认",
        "zh_HK": "寫入 Notion 前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
