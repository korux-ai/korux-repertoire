{
  "spec_version": "korux_capability_v1",
  "id": "design/template-compose",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Template product compose",
  "label_i18n": {
    "en": "Template product compose",
    "zh_CN": "商品卡片模板合成",
    "zh_HK": "商品卡片模板合成"
  },
  "description": "Compose a social-ready product card (product photo + logo + headline) into one image and a social_post artifact after Governor gate",
  "description_i18n": {
    "en": "Compose a social-ready product card (product photo + logo + headline) into one image and a social_post artifact after Governor gate",
    "zh_CN": "将商品图+Logo+标题合成一张社媒卡片图，并产出 social_post 工件（经 Governor）",
    "zh_HK": "將商品圖+Logo+標題合成一張社媒卡片圖，並產出 social_post 工件（經 Governor）"
  },
  "category": "design",
  "reads_external": false,
  "writes_external": false,
  "boundary": "Internal",
  "default_gate": "auto",
  "risk": "low",
  "produces_content": true,
  "propose_guide": "After marketing/product-promo (or ab-copy) and when workspace has product + logo images, compose a single social_post artifact: image (composed) + title + caption. Layouts: xhs_portrait (default 3:4), square, landscape. Downstream xiaohongshu/publish / instagram/publish should map image_file_id/caption/title from this step output — do not special-case skill ids. Runtime needs Pillow on the Korux host. Prefer human review before external publish.",
  "propose_guide_i18n": {
    "en": "After marketing/product-promo when product+logo images exist, compose social_post (image+title+caption). Then xiaohongshu/publish under human gate. Needs Pillow on host.",
    "zh_CN": "在 marketing/product-promo 之后且有商品图+Logo 时，合成 social_post。再经人工门控发小红书。主机需 Pillow。",
    "zh_HK": "在 marketing/product-promo 之後且有商品圖+Logo 時，合成 social_post。再經人工門控發小紅書。主機需 Pillow。"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "product_image_file_id"
    ],
    "properties": {
      "product_image_file_id": {
        "type": "string"
      },
      "logo_file_id": {
        "type": "string"
      },
      "headline": {
        "type": "string",
        "maxLength": 80
      },
      "caption": {
        "type": "string",
        "maxLength": 2000
      },
      "company_name": {
        "type": "string",
        "maxLength": 120
      },
      "layout": {
        "type": "string",
        "enum": [
          "xhs_portrait",
          "square",
          "landscape"
        ]
      },
      "accent_color": {
        "type": "string",
        "maxLength": 7,
        "description": "Hex color e.g. #C41E3A"
      },
      "style": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "content"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "kind": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "layout": {
        "type": "string"
      },
      "image_base64": {
        "type": "string"
      },
      "content_type": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "product_image_file_id",
      "required": true,
      "sources": [
        "step_field",
        "upstream"
      ],
      "description": "Workspace product photo file_id",
      "confirm_if_missing": true
    },
    {
      "name": "logo_file_id",
      "required": false,
      "sources": [
        "step_field",
        "upstream",
        "nl_fixed"
      ],
      "description": "Workspace company logo file_id",
      "confirm_if_missing": false
    },
    {
      "name": "headline",
      "required": false,
      "sources": [
        "upstream",
        "step_field",
        "nl_fixed"
      ],
      "description": "Short on-image headline",
      "propose_hint": "Prefer marketing/product-promo title/headline.",
      "confirm_if_missing": false
    },
    {
      "name": "caption",
      "required": false,
      "sources": [
        "upstream",
        "step_field"
      ],
      "description": "Note body / caption for publish (not only on-image)",
      "propose_hint": "Map from product-promo caption; used by xiaohongshu/publish.",
      "confirm_if_missing": false
    },
    {
      "name": "layout",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "default"
      ],
      "description": "xhs_portrait (default), square, or landscape",
      "confirm_if_missing": false
    },
    {
      "name": "company_name",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "Brand/store name drawn on card footer",
      "confirm_if_missing": false
    }
  ],
  "editable_governor_config": {
    "blocked_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Blocked keywords (headline/caption)",
      "default": []
    },
    "max_image_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15728640,
      "default": 10485760,
      "label": "Max input image bytes"
    }
  },
  "auth": {
    "required": false
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 60000,
    "idempotent": true
  },
  "invoke_tool": "design/template-compose",
  "status": "beta",
  "trust": "first-party",
  "aliases": [
    "template-compose",
    "product-card-compose"
  ]
}
