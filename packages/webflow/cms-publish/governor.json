{
  "spec_version": "korux_governor_v1",
  "capability_id": "webflow/cms-publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "name",
      "slug",
      "field_data",
      "publish"
    ]
  },
  "rules": [
    {
      "id": "block_empty_name",
      "when": {
        "args.name": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "CMS item name is empty",
        "zh_CN": "CMS 条目名称为空",
        "zh_HK": "CMS 條目名稱為空"
      }
    },
    {
      "id": "block_empty_slug",
      "when": {
        "args.slug": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "CMS item slug is empty",
        "zh_CN": "CMS 条目 slug 为空",
        "zh_HK": "CMS 條目 slug 為空"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.name": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "CMS item name contains a blocked keyword",
        "zh_CN": "CMS 条目名称包含禁止关键字",
        "zh_HK": "CMS 條目名稱包含禁止關鍵字"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Webflow CMS create/publish requires human approval",
        "zh_CN": "Webflow CMS 创建/发布前须人工确认",
        "zh_HK": "Webflow CMS 建立/發佈前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
