{
  "spec_version": "korux_capability_v1",
  "id": "zoom",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Zoom",
  "description": "Verify Zoom identity via Server-to-Server OAuth or bearer token (GET /v2/users/me)",
  "category": "meeting",
  "reads_external": true,
  "writes_external": false,
  "boundary": "External",
  "default_gate": "auto",
  "risk": "low",
  "produces_content": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "meeting_id": { "type": "string" },
      "summary": { "type": "string" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "user_id": { "type": "string" },
      "account_id": { "type": "string" },
      "summary": { "type": "string" }
    }
  },
  "params": [
    {
      "name": "meeting_id",
      "required": false,
      "sources": ["nl_fixed", "step_field", "trigger"],
      "description": "Optional meeting id for monitor context",
      "confirm_if_missing": false
    }
  ],
  "auth": {
    "required": true,
    "binding_tool": "zoom",
    "secret_kind": "zoom",
    "credential_doc": "docs/credential.md",
    "fields": [
      { "name": "account_id", "label": "Account id", "type": "text", "required": false },
      { "name": "client_id", "label": "Client id", "type": "text", "required": false },
      { "name": "client_secret", "label": "Client secret", "type": "password", "required": false, "sensitive": true },
      { "name": "token", "label": "Or bearer token", "type": "password", "required": false, "sensitive": true }
    ]
  },
  "runtime": {
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": true
  },
  "invoke_tool": "zoom",
  "binding_tool": "zoom",
  "status": "beta",
  "trust": "first-party"
}
