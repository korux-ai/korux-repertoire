  "produces_content": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "meeting_id": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "user_id": {
        "type": "string"
      },
      "account_id": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "meeting_id",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "trigger"
      ],
