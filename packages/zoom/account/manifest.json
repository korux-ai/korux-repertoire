  "trust": "first-party",
  "aliases": [],
  "editable_governor_config": {},
  "propose_guide": "Use when a workflow needs Zoom identity binding via users/me. Does not create meetings.",
  "propose_guide_i18n": {
    "en": "Use when a workflow needs Zoom identity binding via users/me. Does not create meetings.",
