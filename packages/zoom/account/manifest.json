        "sensitive": true
      },
      {
        "name": "token",
        "label": "Or bearer token",
        "type": "password",
        "required": false,
        "sensitive": true
      }
    ]
  },
  "runtime": {
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": true
