{
  "spec_version": "korux_governor_v1",
  "capability_id": "mailchimp/campaign",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": ["subject", "html", "text", "action", "list_id", "campaign_id"]
  },
  "rules": [
    {
      "id": "block_denied_keywords",
      "when": { "args.html": { "matches_any_owner": "blocked_keywords" } },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": "Campaign HTML contains a blocked keyword"
    },
    {
      "id": "block_denied_url_hosts",
      "when": { "args.html": { "url_host_in_owner": "blocked_url_hosts" } },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": "Campaign HTML contains a blocked URL host"
    },
    {
      "id": "require_human_by_default",
      "when": { "writes_external": true },
      "action": "intercept",
      "gate": "require_human",
      "message": "Mailchimp campaign create/send requires human approval"
    }
  ]
}
