{
  "spec_version": "korux_capability_v1",
  "id": "microsoft/teams",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Microsoft Teams",
  "label_i18n": {
    "en": "Microsoft Teams",
    "zh_CN": "Microsoft Teams",
    "zh_HK": "Microsoft Teams"
  },
  "description": "Verify Microsoft identity for Teams workflows via Graph /me or app-only organization lookup after Vault binding",
  "description_i18n": {
    "en": "Verify Microsoft identity for Teams workflows via Graph /me after Vault binding",
    "zh_CN": "通过 Graph /me 校验 Microsoft 身份，供 Teams 工作流（需 Vault）",
    "zh_HK": "透過 Graph /me 校驗 Microsoft 身分，供 Teams 工作流（需 Vault）"
  },
  "category": "meeting",
  "reads_external": true,
  "writes_external": false,
  "boundary": "External",
  "default_gate": "auto",
  "risk": "low",
  "produces_content": false,
  "propose_guide": "Use when a workflow needs Microsoft Teams identity binding. Pass optional meeting_id from monitor/trigger context. Does not create Teams meetings.",
  "propose_guide_i18n": {
    "en": "When a workflow needs Microsoft Teams identity binding. Does not create Teams meetings.",
    "zh_CN": "工作流需要绑定 Teams 身份时使用。不创建会议。",
    "zh_HK": "工作流需要綁定 Teams 身分時使用。不建立會議。"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "meeting_id": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "provider": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "tenant_id": {
        "type": "string"
      },
      "meeting_id": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "meeting_id",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "trigger"
      ],
      "description": "Optional meeting id for monitor context",
      "confirm_if_missing": false
    }
  ],
  "auth": {
    "required": true,
    "binding_tool": "microsoft/teams",
    "secret_kind": "microsoft-teams",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "access_token",
        "label": "Delegated or app access token",
        "type": "password",
        "required": false,
        "sensitive": true
      },
      {
        "name": "tenant_id",
        "label": "Azure AD tenant ID",
        "type": "text",
        "required": false
      },
      {
        "name": "client_id",
        "label": "App (client) ID",
        "type": "text",
        "required": false
      },
      {
        "name": "client_secret",
        "label": "Client secret",
        "type": "password",
        "required": false,
        "sensitive": true
      }
    ],
    "example_json": "{\"tenant_id\":\"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\",\"client_id\":\"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\",\"client_secret\":\"xxxxx\"}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": true
  },
  "invoke_tool": "microsoft/teams",
  "binding_tool": "microsoft/teams",
  "status": "beta",
  "trust": "first-party",
  "aliases": [
    "microsoft-teams"
  ],
  "editable_governor_config": {}
}
