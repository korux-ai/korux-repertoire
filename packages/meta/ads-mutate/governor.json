{
  "spec_version": "korux_governor_v1",
  "capability_id": "meta/ads-mutate",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "action",
      "object_type",
      "object_id",
      "status",
      "daily_budget"
    ]
  },
  "rules": [
    {
      "id": "block_empty_object_id",
      "when": {
        "args.object_id": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "object_id is empty",
        "zh_CN": "object_id 为空",
        "zh_HK": "object_id 為空"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Meta ads mutate (spend-affecting) requires human approval",
        "zh_CN": "Meta 广告变更（影响花费）前须人工确认",
        "zh_HK": "Meta 廣告變更（影響花費）前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
