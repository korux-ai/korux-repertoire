{
  "spec_version": "korux_governor_v1",
  "capability_id": "wordpress/post",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "title",
      "content",
      "status",
      "excerpt",
      "slug"
    ]
  },
  "rules": [
    {
      "id": "block_empty_title",
      "when": {
        "args.title": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Post title is empty",
        "zh_CN": "帖子标题为空",
        "zh_HK": "帖子標題為空"
      }
    },
    {
      "id": "block_empty_content",
      "when": {
        "args.content": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Post content is empty",
        "zh_CN": "帖子正文为空",
        "zh_HK": "帖子正文為空"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.content": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Post content contains a blocked keyword",
        "zh_CN": "帖子正文包含禁止关键字",
        "zh_HK": "帖子正文包含禁止關鍵字"
      }
    },
    {
      "id": "block_denied_url_hosts",
      "when": {
        "args.content": {
          "url_host_in_owner": "blocked_url_hosts"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Post content contains a blocked URL host",
        "zh_CN": "帖子正文包含禁止的链接域名",
        "zh_HK": "帖子正文包含禁止的連結域名"
      }
    },
    {
      "id": "block_over_max_chars",
      "when": {
        "args.content": {
          "length_gt_owner": "max_chars"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Post content exceeds Owner max_chars",
        "zh_CN": "帖子正文超过 Owner 字数上限",
        "zh_HK": "帖子正文超過 Owner 字數上限"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "WordPress post create/publish requires human approval",
        "zh_CN": "WordPress 发帖/发布前须人工确认",
        "zh_HK": "WordPress 發帖/發佈前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
