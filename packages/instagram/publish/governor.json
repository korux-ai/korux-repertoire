{
  "spec_version": "korux_governor_v1",
  "capability_id": "instagram/publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "caption",
      "image_file_id"
    ]
  },
  "rules": [
    {
      "id": "block_empty_caption",
      "when": {
        "args.caption": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Caption is empty; use upstream step output",
        "zh_CN": "文案为空；须使用上游步骤产出",
        "zh_HK": "文案為空；須使用上游步驟產出"
      }
    },
    {
      "id": "block_missing_image",
      "when": {
        "args.image_file_id": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Instagram Feed posts require image_file_id",
        "zh_CN": "Instagram Feed 发帖需要 image_file_id",
        "zh_HK": "Instagram Feed 發帖需要 image_file_id"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.caption": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Caption contains a blocked keyword",
        "zh_CN": "文案包含禁止关键字",
        "zh_HK": "文案包含禁止關鍵字"
      }
    },
    {
      "id": "block_denied_url_hosts",
      "when": {
        "args.caption": {
          "url_host_in_owner": "blocked_url_hosts"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Caption contains a blocked URL host",
        "zh_CN": "文案包含禁止的链接域名",
        "zh_HK": "文案包含禁止的連結域名"
      }
    },
    {
      "id": "block_over_max_chars",
      "when": {
        "args.caption": {
          "length_gt_owner": "max_chars"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Caption exceeds Owner max_chars",
        "zh_CN": "文案超过 Owner 字数上限",
        "zh_HK": "文案超過 Owner 字數上限"
      }
    },
    {
      "id": "block_over_max_mentions",
      "when": {
        "args.caption": {
          "mentions_gt_owner": "max_mentions"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Caption @ mention count exceeds Owner limit",
        "zh_CN": "文案 @ 次数超过 Owner 上限",
        "zh_HK": "文案 @ 次數超過 Owner 上限"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Instagram Feed posts require human approval",
        "zh_CN": "Instagram Feed 发帖前须人工确认",
        "zh_HK": "Instagram Feed 發帖前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
