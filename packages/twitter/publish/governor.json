{
  "spec_version": "korux_governor_v1",
  "capability_id": "twitter/publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "content",
      "image_file_id"
    ]
  },
  "rules": [
    {
      "id": "block_empty_content",
      "when": {
        "args.content": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Tweet body is empty; use upstream step output.",
        "zh_CN": "推文正文为空；须使用上游步骤产出",
        "zh_HK": "推文正文為空；須使用上游步驟產出"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.content": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Tweet contains a blocked keyword",
        "zh_CN": "推文包含禁止关键字",
        "zh_HK": "推文包含禁止關鍵字"
      }
    },
    {
      "id": "block_denied_url_hosts",
      "when": {
        "args.content": {
          "url_host_in_owner": "blocked_url_hosts"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Tweet contains a blocked URL host",
        "zh_CN": "推文包含禁止的链接域名",
        "zh_HK": "推文包含禁止的連結域名"
      }
    },
    {
      "id": "block_over_max_chars",
      "when": {
        "args.content": {
          "length_gt_owner": "max_chars"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Tweet exceeds Owner max character limit",
        "zh_CN": "推文超过 Owner 设定的字数上限",
        "zh_HK": "推文超過 Owner 設定的字數上限"
      }
    },
    {
      "id": "block_over_max_mentions",
      "when": {
        "args.content": {
          "mentions_gt_owner": "max_mentions"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Tweet @ mention count exceeds the limit",
        "zh_CN": "推文 @ 次数超过上限",
        "zh_HK": "推文 @ 次數超過上限"
      }
    },
    {
      "id": "require_image_when_configured",
      "when": {
        "args.image_file_id": {
          "empty_when_owner_true": "require_image"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Owner requires posts to include an image",
        "zh_CN": "Owner 要求发帖必须带图",
        "zh_HK": "Owner 要求發帖必須帶圖"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Human confirmation required before publishing a tweet",
        "zh_CN": "发布推文前须人工确认",
        "zh_HK": "發佈推文前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
