{
  "spec_version": "korux_governor_v1",
  "capability_id": "linkedin/publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "commentary",
      "image_file_id"
    ]
  },
  "rules": [
    {
      "id": "block_empty_commentary",
      "when": {
        "args.commentary": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Commentary is empty; use upstream step output",
        "zh_CN": "评论正文为空；须使用上游步骤产出",
        "zh_HK": "評論正文為空；須使用上游步驟產出"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.commentary": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Commentary contains a blocked keyword",
        "zh_CN": "评论包含禁止关键字",
        "zh_HK": "評論包含禁止關鍵字"
      }
    },
    {
      "id": "block_denied_url_hosts",
      "when": {
        "args.commentary": {
          "url_host_in_owner": "blocked_url_hosts"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Commentary contains a blocked URL host",
        "zh_CN": "评论包含禁止的链接域名",
        "zh_HK": "評論包含禁止的連結域名"
      }
    },
    {
      "id": "block_over_max_chars",
      "when": {
        "args.commentary": {
          "length_gt_owner": "max_chars"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Commentary exceeds Owner max_chars",
        "zh_CN": "评论超过 Owner 字数上限",
        "zh_HK": "評論超過 Owner 字數上限"
      }
    },
    {
      "id": "block_over_max_mentions",
      "when": {
        "args.commentary": {
          "mentions_gt_owner": "max_mentions"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Commentary @ mention count exceeds Owner limit",
        "zh_CN": "评论 @ 次数超过 Owner 上限",
        "zh_HK": "評論 @ 次數超過 Owner 上限"
      }
    },
    {
      "id": "require_image_when_configured",
      "when": {
        "args.image_file_id": {
          "empty_when_owner_true": "require_image"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Owner requires an image on LinkedIn posts",
        "zh_CN": "Owner 要求 LinkedIn 发帖必须带图",
        "zh_HK": "Owner 要求 LinkedIn 發帖必須帶圖"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "LinkedIn Company Page posts require human approval",
        "zh_CN": "LinkedIn 公司页发帖前须人工确认",
        "zh_HK": "LinkedIn 公司頁發帖前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
