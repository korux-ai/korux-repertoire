{
  "spec_version": "korux_capability_v1",
  "id": "example-connector",
  "version": "0.1.0",
  "kind": "connector",
  "errors": {
    "emitted": ["auth", "empty", "unavailable", "validation", "denied", "provider"]
  },
  "label": "Example connector",
  "description": "Template capability package for contributors",
  "category": "other",
  "reads_external": false,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "medium",
  "auth": {
    "required": false,
    "binding_tool": "example-connector"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": false
  },
  "editable_governor_config": {
    "blocked_keywords": {
      "type": "array",
      "items": { "type": "string" },
      "label": "Blocked keywords",
      "description": "Reject when body contains any listed substring.",
      "default": []
    },
    "min_body_length": {
      "type": "integer",
      "minimum": 1,
      "label": "Minimum body length"
    }
  },
  "status": "beta",
  "trust": "community"
}
