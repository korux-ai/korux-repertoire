{
  "spec_version": "korux_governor_v1",
  "capability_id": "youtube/publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": ["title", "description", "privacy_status", "tags", "category_id"]
  },
  "rules": [
    {
      "id": "block_empty_title",
      "when": { "args.title": { "empty": true } },
      "action": "reject",
      "code": "VALIDATION",
      "message": "Video title is empty"
    },
    {
      "id": "block_denied_keywords",
      "when": { "args.title": { "matches_any_owner": "blocked_keywords" } },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": "Title contains a blocked keyword"
    },
    {
      "id": "require_human_by_default",
      "when": { "writes_external": true },
      "action": "intercept",
      "gate": "require_human",
      "message": "YouTube upload requires human approval"
    }
  ]
}
