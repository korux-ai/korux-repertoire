{
  "spec_version": "korux_governor_v1",
  "capability_id": "youtube/publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "title",
      "description",
      "privacy_status",
      "tags",
      "category_id"
    ]
  },
  "rules": [
    {
      "id": "block_empty_title",
      "when": {
        "args.title": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Video title is empty",
        "zh_CN": "视频标题为空",
        "zh_HK": "影片標題為空"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.title": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Title contains a blocked keyword",
        "zh_CN": "标题包含禁止关键字",
        "zh_HK": "標題包含禁止關鍵字"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "YouTube upload requires human approval",
        "zh_CN": "YouTube 上传前须人工确认",
        "zh_HK": "YouTube 上傳前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
