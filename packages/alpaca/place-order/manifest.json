{
  "spec_version": "korux_capability_v1",
  "id": "alpaca/place-order",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Place trade order",
  "label_i18n": {
    "en": "Place trade order",
    "zh_CN": "下单（Alpaca 模拟）",
    "zh_HK": "落盤（Alpaca 模擬）"
  },
  "description": "Submit a market order to Alpaca paper trading after Vault binding and Governor gate (not a local stub)",
  "description_i18n": {
    "en": "Submit a market order to Alpaca paper trading after Vault binding and Governor gate",
    "zh_CN": "在 Vault 绑定与 Governor 门控后，向 Alpaca 模拟盘提交市价单",
    "zh_HK": "在 Vault 綁定與 Governor 門控後，向 Alpaca 模擬盤提交市價單"
  },
  "category": "trading",
  "reads_external": false,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "high",
  "produces_content": false,
  "propose_guide": "Gated paper trade only. Set symbol, side, and quantity from NL or step fields. Live Alpaca URLs are refused.",
  "propose_guide_i18n": {
    "en": "Gated paper trade only. Set symbol, side, and quantity from NL. Live Alpaca URLs are refused.",
    "zh_CN": "仅用于带门控的模拟交易。从自然语言设置代码、买卖方向与数量。拒绝实盘 URL。",
    "zh_HK": "僅用於帶門控的模擬交易。從自然語言設定代碼、買賣方向與數量。拒絕實盤 URL。"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "symbol",
      "side",
      "quantity"
    ],
    "properties": {
      "symbol": {
        "type": "string",
        "maxLength": 16
      },
      "side": {
        "type": "string",
        "enum": [
          "buy",
          "sell"
        ]
      },
      "quantity": {
        "type": "number",
        "minimum": 0.0001
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "order_id": {
        "type": "string"
      },
      "order_status": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "symbol",
      "required": true,
      "sources": [
        "nl_fixed",
        "step_field"
      ],
      "description": "Ticker symbol",
      "example_nl": "Buy 1 share of AAPL on paper",
      "confirm_if_missing": true
    },
    {
      "name": "side",
      "required": true,
      "sources": [
        "nl_fixed",
        "step_field"
      ],
      "description": "buy or sell",
      "confirm_if_missing": true
    },
    {
      "name": "quantity",
      "required": true,
      "sources": [
        "nl_fixed",
        "step_field"
      ],
      "description": "Positive quantity",
      "confirm_if_missing": true
    }
  ],
  "auth": {
    "required": true,
    "binding_tool": "alpaca/place-order",
    "secret_kind": "broker",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "api_secret",
        "label": "API secret",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "base_url",
        "label": "Paper API base URL (optional)",
        "type": "text",
        "required": false,
        "default_value": "https://paper-api.alpaca.markets"
      }
    ]
  },
  "runtime": {
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": false
  },
  "invoke_tool": "alpaca/place-order",
  "binding_tool": "alpaca/place-order",
  "status": "stable",
  "trust": "first-party",
  "aliases": [],
  "editable_governor_config": {}
}
