{
  "spec_version": "korux_capability_v1",
  "id": "hubspot/contact-upsert",
  "version": "1.0.0",
  "kind": "connector",
  "label": "HubSpot contact upsert",
  "label_i18n": {
    "en": "HubSpot contact upsert",
    "zh_CN": "HubSpot 联系人写入",
    "zh_HK": "HubSpot 聯絡人寫入"
  },
  "description": "Create or update a HubSpot CRM contact by email (or patch by contact_id) after Vault binding and Governor gate",
  "description_i18n": {
    "en": "Create or update a HubSpot CRM contact by email (or patch by contact_id) after Vault binding and Governor gate",
    "zh_CN": "按邮箱创建/更新 HubSpot 联系人（或按 contact_id 补丁；需 Vault 与 Governor）",
    "zh_HK": "按電郵建立/更新 HubSpot 聯絡人（或按 contact_id 補丁；需 Vault 與 Governor）"
  },
  "category": "crm",
  "reads_external": true,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "medium",
  "produces_content": false,
  "propose_guide": "Upsert CRM contacts from leads, forms, or campaign lists. Prefer email for find-or-create; use contact_id only when updating a known record. Does not create notes — use hubspot/crm-note for activity logging.",
  "propose_guide_i18n": {
    "en": "Upsert CRM contacts from leads/forms. Prefer email for find-or-create. Notes → hubspot/crm-note.",
    "zh_CN": "从线索/表单写入 CRM 联系人。优先用邮箱查找或创建。备注用 hubspot/crm-note。",
    "zh_HK": "從線索/表單寫入 CRM 聯絡人。優先用電郵查找或建立。備註用 hubspot/crm-note。"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "maxLength": 320
      },
      "contact_id": {
        "type": "string"
      },
      "firstname": {
        "type": "string",
        "maxLength": 100
      },
      "lastname": {
        "type": "string",
        "maxLength": 100
      },
      "phone": {
        "type": "string",
        "maxLength": 50
      },
      "company": {
        "type": "string",
        "maxLength": 200
      },
      "jobtitle": {
        "type": "string",
        "maxLength": 200
      },
      "website": {
        "type": "string",
        "maxLength": 500
      },
      "lifecyclestage": {
        "type": "string",
        "maxLength": 100
      },
      "properties": {
        "type": "object",
        "description": "Additional HubSpot contact property name → string value"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "contact_id": {
        "type": "string"
      },
      "action": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "email",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "Contact email (required unless contact_id is set)",
      "confirm_if_missing": false
    },
    {
      "name": "contact_id",
      "required": false,
      "sources": [
        "upstream",
        "step_field",
        "nl_fixed"
      ],
      "description": "Existing HubSpot contact id for update-only",
      "confirm_if_missing": false
    },
    {
      "name": "firstname",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "First name",
      "confirm_if_missing": false
    },
    {
      "name": "lastname",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "Last name",
      "confirm_if_missing": false
    },
    {
      "name": "company",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "Company name",
      "confirm_if_missing": false
    }
  ],
  "editable_governor_config": {
    "blocked_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Blocked keywords (checked against company/jobtitle)",
      "default": []
    },
    "allowed_email_domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Allowed email domains (empty = any)",
      "default": []
    }
  },
  "auth": {
    "required": true,
    "binding_tool": "hubspot/contact-upsert",
    "secret_kind": "hubspot",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "access_token",
        "label": "Private app access token",
        "type": "password",
        "required": true,
        "sensitive": true
      }
    ],
    "example_json": "{\"access_token\":\"pat-na1-xxxxxxxx\"}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 45000,
    "idempotent": false
  },
  "invoke_tool": "hubspot/contact-upsert",
  "binding_tool": "hubspot/contact-upsert",
  "status": "beta",
  "trust": "first-party",
  "aliases": [
    "hubspot-contact"
  ]
}
