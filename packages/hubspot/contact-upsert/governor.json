{
  "spec_version": "korux_governor_v1",
  "capability_id": "hubspot/contact-upsert",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "email",
      "contact_id",
      "firstname",
      "lastname",
      "phone",
      "company",
      "jobtitle",
      "website",
      "lifecyclestage",
      "properties"
    ]
  },
  "rules": [
    {
      "id": "block_denied_keywords_company",
      "when": {
        "args.company": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Company contains a blocked keyword",
        "zh_CN": "公司名包含禁止关键字",
        "zh_HK": "公司名包含禁止關鍵字"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "HubSpot contact upsert requires human approval",
        "zh_CN": "HubSpot 联系人写入前须人工确认",
        "zh_HK": "HubSpot 聯絡人寫入前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
