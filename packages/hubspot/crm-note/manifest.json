{
  "spec_version": "korux_capability_v1",
  "id": "hubspot/crm-note",
  "version": "1.0.0",
  "kind": "connector",
  "label": "HubSpot CRM note",
  "label_i18n": {
    "en": "HubSpot CRM note",
    "zh_CN": "HubSpot CRM 备注",
    "zh_HK": "HubSpot CRM 備註"
  },
  "description": "Create a HubSpot CRM note on a contact (by contact_id or email upsert) after Vault binding and Governor gate",
  "description_i18n": {
    "en": "Create a HubSpot CRM note on a contact (by contact_id or email upsert) after Vault binding and Governor gate",
    "zh_CN": "在联系人上创建 HubSpot CRM 备注（按 contact_id 或邮箱；需 Vault 与 Governor）",
    "zh_HK": "在聯絡人上建立 HubSpot CRM 備註（按 contact_id 或電郵；需 Vault 與 Governor）"
  },
  "category": "crm",
  "reads_external": true,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "medium",
  "produces_content": false,
  "propose_guide": "Log marketing/sales handoff notes after research or meetings. Prefer contact_id when known; otherwise email creates/finds the contact then attaches the note.",
  "propose_guide_i18n": {
    "en": "Log marketing/sales handoff notes after research or meetings. Prefer contact_id when known.",
    "zh_CN": "调研或会议后记录营销/销售交接备注。已知 contact_id 时优先使用。",
    "zh_HK": "調研或會議後記錄營銷/銷售交接備註。已知 contact_id 時優先使用。"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "body"
    ],
    "properties": {
      "body": {
        "type": "string",
        "maxLength": 10000
      },
      "contact_id": {
        "type": "string"
      },
      "email": {
        "type": "string",
        "maxLength": 320
      },
      "firstname": {
        "type": "string",
        "maxLength": 100
      },
      "lastname": {
        "type": "string",
        "maxLength": 100
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "note_id": {
        "type": "string"
      },
      "contact_id": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "body",
      "required": true,
      "sources": [
        "upstream",
        "step_field",
        "nl_fixed"
      ],
      "description": "Note body text",
      "propose_hint": "Set body from upstream summary; do not paste raw task NL.",
      "confirm_if_missing": true
    },
    {
      "name": "contact_id",
      "required": false,
      "sources": [
        "upstream",
        "step_field",
        "nl_fixed"
      ],
      "description": "HubSpot contact id when known",
      "confirm_if_missing": false
    },
    {
      "name": "email",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "upstream"
      ],
      "description": "Contact email used to find or create the contact when contact_id is absent",
      "confirm_if_missing": false
    }
  ],
  "editable_governor_config": {
    "blocked_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Blocked keywords",
      "default": []
    },
    "max_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 10000,
      "label": "Max note characters"
    }
  },
  "auth": {
    "required": true,
    "binding_tool": "hubspot/crm-note",
    "secret_kind": "hubspot",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "access_token",
        "label": "Private app access token",
        "type": "password",
        "required": true,
        "sensitive": true
      }
    ],
    "example_json": "{\"access_token\":\"pat-na1-xxxxxxxx\"}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 45000,
    "idempotent": false
  },
  "invoke_tool": "hubspot/crm-note",
  "binding_tool": "hubspot/crm-note",
  "status": "beta",
  "trust": "first-party",
  "aliases": []
}
