{
  "spec_version": "korux_governor_v1",
  "capability_id": "hubspot/crm-note",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "body",
      "contact_id",
      "email",
      "firstname",
      "lastname"
    ]
  },
  "rules": [
    {
      "id": "block_empty_body",
      "when": {
        "args.body": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Note body is empty",
        "zh_CN": "备注正文为空",
        "zh_HK": "備註正文為空"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.body": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Note contains a blocked keyword",
        "zh_CN": "备注包含禁止关键字",
        "zh_HK": "備註包含禁止關鍵字"
      }
    },
    {
      "id": "block_over_max_chars",
      "when": {
        "args.body": {
          "length_gt_owner": "max_chars"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Note exceeds Owner max_chars",
        "zh_CN": "备注超过 Owner 字数上限",
        "zh_HK": "備註超過 Owner 字數上限"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "HubSpot CRM writes require human approval",
        "zh_CN": "HubSpot CRM 写入前须人工确认",
        "zh_HK": "HubSpot CRM 寫入前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
