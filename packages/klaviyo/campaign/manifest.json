{
  "spec_version": "korux_capability_v1",
  "id": "klaviyo/campaign",
  "version": "1.0.0",
  "kind": "connector",
  "label": "Klaviyo campaign",
  "label_i18n": {
    "en": "Klaviyo campaign",
    "zh_CN": "Klaviyo 邮件活动",
    "zh_HK": "Klaviyo 郵件活動"
  },
  "description": "Create a Klaviyo email campaign with HTML template (optional send) after Vault binding and Governor gate",
  "description_i18n": {
    "en": "Create a Klaviyo email campaign with HTML template (optional send) after Vault binding and Governor gate",
    "zh_CN": "创建带 HTML 模板的 Klaviyo 邮件活动（可选发送；需 Vault 与 Governor）",
    "zh_HK": "建立帶 HTML 模板的 Klaviyo 郵件活動（可選發送；需 Vault 與 Governor）"
  },
  "category": "email",
  "reads_external": false,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "high",
  "produces_content": false,
  "propose_guide": "Use for ecommerce/lifecycle email after compose. Default action creates campaign + template assignment without sending. Use action=send or create_and_send only when NL explicitly asks to send.",
  "propose_guide_i18n": {
    "en": "Ecommerce/lifecycle email after compose. Default creates without sending. send/create_and_send only when NL explicitly asks.",
    "zh_CN": "成文后做电商/生命周期邮件。默认只创建不发送。仅当用户明确要求发送时才 send。",
    "zh_HK": "成文後做電商/生命周期郵件。預設只建立不發送。僅當用戶明確要求發送時才 send。"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "send",
          "create_and_send"
        ]
      },
      "name": {
        "type": "string",
        "maxLength": 200
      },
      "subject": {
        "type": "string",
        "maxLength": 200
      },
      "html": {
        "type": "string",
        "maxLength": 200000
      },
      "list_id": {
        "type": "string"
      },
      "campaign_id": {
        "type": "string"
      },
      "preview_text": {
        "type": "string",
        "maxLength": 255
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "campaign_id": {
        "type": "string"
      },
      "message_id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "action",
      "required": false,
      "sources": [
        "nl_fixed",
        "step_field",
        "default"
      ],
      "description": "create (default), send, or create_and_send",
      "confirm_if_missing": false
    },
    {
      "name": "subject",
      "required": false,
      "sources": [
        "upstream",
        "step_field",
        "nl_fixed"
      ],
      "description": "Email subject (required for create)",
      "confirm_if_missing": false
    },
    {
      "name": "html",
      "required": false,
      "sources": [
        "upstream",
        "step_field"
      ],
      "description": "HTML body (required for create)",
      "confirm_if_missing": false
    },
    {
      "name": "campaign_id",
      "required": false,
      "sources": [
        "upstream",
        "step_field"
      ],
      "description": "Required when action=send",
      "confirm_if_missing": false
    }
  ],
  "editable_governor_config": {
    "blocked_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Blocked keywords",
      "default": []
    },
    "blocked_url_hosts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Blocked URL hosts",
      "default": []
    }
  },
  "auth": {
    "required": true,
    "binding_tool": "klaviyo/campaign",
    "secret_kind": "klaviyo",
    "credential_doc": "docs/credential.md",
    "fields": [
      {
        "name": "api_key",
        "label": "Private API key",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "list_id",
        "label": "Default list/segment ID",
        "type": "text",
        "required": true
      },
      {
        "name": "from_email",
        "label": "From email",
        "type": "text",
        "required": true
      },
      {
        "name": "from_label",
        "label": "From name/label",
        "type": "text",
        "required": true
      },
      {
        "name": "revision",
        "label": "API revision header",
        "type": "text",
        "required": false,
        "default_value": "2024-10-15"
      }
    ],
    "example_json": "{\"api_key\":\"pk_xxxxx\",\"list_id\":\"AbC123\",\"from_email\":\"hello@example.com\",\"from_label\":\"Acme\",\"revision\":\"2024-10-15\"}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 90000,
    "idempotent": false
  },
  "invoke_tool": "klaviyo/campaign",
  "binding_tool": "klaviyo/campaign",
  "status": "beta",
  "trust": "first-party",
  "aliases": []
}
