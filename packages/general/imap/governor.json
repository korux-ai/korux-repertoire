{
  "spec_version": "korux_governor_v1",
  "capability_id": "general/imap",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": false,
    "editable_fields": [],
    "non_editable_fields": []
  },
  "rules": [
    {
      "id": "external_read_auto",
      "when": {
        "reads_external": true
      },
      "action": "pass",
      "gate": "auto",
      "message": "IMAP poll is External read; default gate auto"
    }
  ]
}
