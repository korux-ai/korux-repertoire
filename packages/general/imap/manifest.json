{
  "spec_version": "korux_capability_v1",
  "id": "general/imap",
  "version": "1.1.0",
  "kind": "connector",
  "label": "IMAP inbox",
  "label_i18n": {
    "en": "IMAP inbox",
    "zh_CN": "IMAP 收件箱",
    "zh_HK": "IMAP 收件箱"
  },
  "description": "Poll an IMAP inbox for UNSEEN mail — as a monitor trigger or as a Spec mid-flow step; requires Vault imap Config",
  "description_i18n": {
    "en": "Poll an IMAP inbox for UNSEEN mail — as a monitor trigger or as a Spec mid-flow step; requires Vault imap Config",
    "zh_CN": "轮询 IMAP 未读邮件：可用作监控触发，或用作 Spec 中间步；需 Vault imap Config",
    "zh_HK": "輪詢 IMAP 未讀郵件：可用作監控觸發，或用作 Spec 中間步；需 Vault imap Config"
  },
  "category": "email",
  "reads_external": true,
  "writes_external": false,
  "boundary": "External",
  "default_gate": "auto",
  "risk": "low",
  "aliases": [
    "inbound-email-monitor",
    "inbound_email",
    "inbound-email",
    "inbound"
  ],
  "produces_content": true,
  "propose_guide": "Two usages, same poll=UNSEEN only. (A) Monitor trigger: kind=monitor when NL is watch/inbox arrives. (B) Spec step after manual/other trigger when NL says read latest unread email mid-flow — then korux/llm-summarize. Do not invent already-seen mail. See docs/USAGE.md.",
  "propose_guide_i18n": {
    "en": "Two usages, same UNSEEN poll: (A) monitor trigger for inbox-arrives; (B) Spec mid-flow step after manual start to read unread mail, then summarize. Never read already-seen as 'latest'.",
    "zh_CN": "同一 UNSEEN poll、两种用法：(A) 监控触发（来信起跑）；(B) 非 monitor 触发后的 Spec 中间步读未读邮件，再接摘要。不要把已读当「最新」。",
    "zh_HK": "同一 UNSEEN poll、兩種用法：(A) 監控觸發（來信起跑）；(B) 非 monitor 觸發後的 Spec 中間步讀未讀郵件，再接摘要。不要把已讀當「最新」。"
  },
  "input_prepare_default": {
    "mode": "static"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "poll (default, UNSEEN) or mark_seen"
      },
      "from_filter": {
        "type": "string",
        "description": "Optional sender filter"
      },
      "subject_contains": {
        "type": "string"
      },
      "seen_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Message-ids already processed (dedupe); not a content harvest field"
      },
      "uids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "IMAP UIDs for mark_seen only"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "messages": {
        "type": "array"
      },
      "count": {
        "type": "integer"
      },
      "subject": {
        "type": "string"
      },
      "from": {
        "type": "string"
      },
      "body": {
        "type": "string"
      }
    }
  },
  "params": [],
  "auth": {
    "required": true,
    "binding_tool": "inbound-email-monitor",
    "secret_kind": "imap",
    "fields": [
      {
        "name": "host",
        "label": "Host",
        "type": "text",
        "required": true,
        "placeholder": "imap.gmail.com"
      },
      {
        "name": "port",
        "label": "Port",
        "type": "number",
        "required": true,
        "default_value": "993"
      },
      {
        "name": "username",
        "label": "Username",
        "type": "text",
        "required": true,
        "placeholder": "you@example.com"
      },
      {
        "name": "password",
        "label": "Password / app password",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "folder",
        "label": "Folder",
        "type": "text",
        "required": false,
        "default_value": "INBOX",
        "placeholder": "INBOX"
      },
      {
        "name": "use_ssl",
        "label": "Use SSL",
        "type": "checkbox",
        "default_value": "true"
      },
      {
        "name": "mark_read_on_process",
        "label": "Mark read after processing",
        "type": "checkbox",
        "default_value": "true"
      }
    ],
    "sub_presets": [
      {
        "id": "gmail",
        "label": "Gmail",
        "defaults": {
          "host": "imap.gmail.com",
          "port": "993",
          "use_ssl": "true",
          "folder": "INBOX"
        },
        "note": "Password must be an app password; enable IMAP in Gmail settings."
      },
      {
        "id": "163",
        "label": "163",
        "defaults": {
          "host": "imap.163.com",
          "port": "993",
          "use_ssl": "true",
          "folder": "INBOX"
        },
        "note": "Password must be an authorization code."
      },
      {
        "id": "custom",
        "label": "Custom",
        "defaults": {
          "folder": "INBOX"
        },
        "note": "Fill host / port yourself."
      }
    ],
    "example_json": "{\"host\":\"imap.gmail.com\",\"port\":993,\"username\":\"you@gmail.com\",\"password\":\"xxxx xxxx xxxx xxxx\",\"folder\":\"INBOX\",\"use_ssl\":true,\"mark_read_on_process\":true}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 60000,
    "idempotent": true
  },
  "invoke_tool": "inbound-email-monitor",
  "binding_tool": "inbound-email-monitor",
  "step_kind": "connector",
  "status": "stable",
  "trust": "first-party",
  "editable_governor_config": {}
}
