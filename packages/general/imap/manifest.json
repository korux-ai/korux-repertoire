{
  "spec_version": "korux_capability_v1",
  "id": "general/imap",
  "version": "1.2.0",
  "kind": "connector",
  "label": "IMAP inbox",
  "label_i18n": {
    "en": "IMAP inbox",
    "zh_CN": "IMAP 收件箱",
    "zh_HK": "IMAP 收件箱"
  },
  "description": "IMAP UNSEEN: poll for monitor triggers, or read (consume) as a Spec mid-flow step; requires Vault imap Config",
  "description_i18n": {
    "en": "IMAP UNSEEN: poll for monitor triggers, or read (consume) as a Spec mid-flow step; requires Vault imap Config",
    "zh_CN": "IMAP 未读：poll 用于监控触发，read 用于 Spec 中间步读入（可按 Config 标已读）；需 Vault imap Config",
    "zh_HK": "IMAP 未讀：poll 用於監控觸發，read 用於 Spec 中間步讀入（可按 Config 標已讀）；需 Vault imap Config"
  },
  "category": "email",
  "reads_external": true,
  "writes_external": false,
  "boundary": "External",
  "default_gate": "auto",
  "risk": "low",
  "aliases": [
    "inbound-email-monitor",
    "inbound_email",
    "inbound-email",
    "inbound"
  ],
  "produces_content": true,
  "propose_guide": "Two actions on UNSEEN only. (A) Monitor trigger → action=poll (detect; do not mark). (B) Spec mid-flow → action=read (ingest; mark_read_on_process applies), then summarize/decide. Do not combine A+B for the same signal. See docs/USAGE.md.",
  "propose_guide_i18n": {
    "en": "UNSEEN only: (A) monitor → poll (detect, no mark); (B) Spec mid-flow → read (consume; mark_read_on_process). Prefer not combining A+B for the same mail.",
    "zh_CN": "仅 UNSEEN：(A) 监控 → poll（探测、不标已读）；(B) Spec 中间步 → read（读入；套用 mark_read_on_process）。同一信号尽量不要 A+B 并用。",
    "zh_HK": "僅 UNSEEN：(A) 監控 → poll（探測、不標已讀）；(B) Spec 中間步 → read（讀入；套用 mark_read_on_process）。同一信號盡量不要 A+B 並用。"
  },
  "input_prepare_default": {
    "mode": "static"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "poll (detect UNSEEN, default) | read (consume UNSEEN; mark_read_on_process) | mark_seen"
      },
      "from_filter": {
        "type": "string",
        "description": "Optional sender filter"
      },
      "subject_contains": {
        "type": "string"
      },
      "seen_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Message-ids already processed (dedupe); not a content harvest field"
      },
      "uids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "IMAP UIDs for mark_seen only"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "messages": {
        "type": "array"
      },
      "count": {
        "type": "integer"
      },
      "subject": {
        "type": "string"
      },
      "from": {
        "type": "string"
      },
      "body": {
        "type": "string"
      }
    }
  },
  "params": [],
  "auth": {
    "required": true,
    "binding_tool": "inbound-email-monitor",
    "secret_kind": "imap",
    "fields": [
      {
        "name": "host",
        "label": "Host",
        "type": "text",
        "required": true,
        "placeholder": "imap.gmail.com"
      },
      {
        "name": "port",
        "label": "Port",
        "type": "number",
        "required": true,
        "default_value": "993"
      },
      {
        "name": "username",
        "label": "Username",
        "type": "text",
        "required": true,
        "placeholder": "you@example.com"
      },
      {
        "name": "password",
        "label": "Password / app password",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "folder",
        "label": "Folder",
        "type": "text",
        "required": false,
        "default_value": "INBOX",
        "placeholder": "INBOX"
      },
      {
        "name": "use_ssl",
        "label": "Use SSL",
        "type": "checkbox",
        "default_value": "true"
      },
      {
        "name": "mark_read_on_process",
        "label": "Mark read after Spec read",
        "type": "checkbox",
        "default_value": "true"
      }
    ],
    "sub_presets": [
      {
        "id": "gmail",
        "label": "Gmail",
        "defaults": {
          "host": "imap.gmail.com",
          "port": "993",
          "use_ssl": "true",
          "folder": "INBOX"
        },
        "note": "Password must be an app password; enable IMAP in Gmail settings."
      },
      {
        "id": "163",
        "label": "163",
        "defaults": {
          "host": "imap.163.com",
          "port": "993",
          "use_ssl": "true",
          "folder": "INBOX"
        },
        "note": "Password must be an authorization code."
      },
      {
        "id": "custom",
        "label": "Custom",
        "defaults": {
          "folder": "INBOX"
        },
        "note": "Fill host / port yourself."
      }
    ],
    "example_json": "{\"host\":\"imap.gmail.com\",\"port\":993,\"username\":\"you@gmail.com\",\"password\":\"xxxx xxxx xxxx xxxx\",\"folder\":\"INBOX\",\"use_ssl\":true,\"mark_read_on_process\":true}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 60000,
    "idempotent": true
  },
  "invoke_tool": "inbound-email-monitor",
  "binding_tool": "inbound-email-monitor",
  "step_kind": "connector",
  "status": "stable",
  "trust": "first-party",
  "editable_governor_config": {}
}
