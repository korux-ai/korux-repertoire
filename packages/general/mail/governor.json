{
  "spec_version": "korux_governor_v1",
  "capability_id": "general/mail",
  "capability_version": "1.1.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "to",
      "subject",
      "body"
    ],
    "non_editable_fields": [
      "from"
    ]
  },
  "rules": [
    {
      "id": "block_empty_body",
      "when": {
        "args.body": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": "邮件正文为空；须使用上游步骤产出"
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": "发送邮件前须人工确认"
    }
  ]
}
