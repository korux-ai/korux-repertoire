{
  "spec_version": "korux_capability_v1",
  "id": "general/mail",
  "version": "1.2.0",
  "kind": "connector",
  "label": "Send email",
  "label_i18n": {
    "en": "Send email",
    "zh_CN": "发送邮件",
    "zh_HK": "發送郵件"
  },
  "description": "Send email via SMTP after Vault binding and Governor gate",
  "description_i18n": {
    "en": "Send email via SMTP after Vault binding and Governor gate",
    "zh_CN": "在 Vault 绑定与 Governor 门控后通过 SMTP 发送邮件",
    "zh_HK": "在 Vault 綁定與 Governor 門控後透過 SMTP 發送郵件"
  },
  "category": "email",
  "reads_external": false,
  "writes_external": true,
  "boundary": "External",
  "default_gate": "require_human",
  "risk": "medium",
  "aliases": [
    "smtp"
  ],
  "produces_content": false,
  "propose_guide": "External send after Internal summarize/read steps: email body must be upstream structured output, not the task NL verbatim.",
  "propose_guide_i18n": {
    "en": "External send after Internal summarize: body from upstream structured output, not task NL verbatim.",
    "zh_CN": "内部摘要后再外发：正文用上游结构化产出，勿直接用任务原话。",
    "zh_HK": "內部摘要後再外發：正文用上游結構化產出，勿直接用任務原話。"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "to",
      "subject",
      "body"
    ],
    "properties": {
      "to": {
        "type": "string",
        "format": "email"
      },
      "subject": {
        "type": "string",
        "maxLength": 200
      },
      "body": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "to": {
        "type": "string"
      }
    }
  },
  "params": [
    {
      "name": "to",
      "required": true,
      "sources": [
        "nl_fixed",
        "step_field",
        "runtime_override",
        "trigger"
      ],
      "description": "收件人邮箱地址",
      "example_nl": "发邮件到 legal@company.com 通知法务团队",
      "propose_hint": "When NL names a recipient, set step field `to` to a valid email. Team or role names without @ are NOT enough.",
      "trigger_match": {
        "kinds": [
          "monitor"
        ],
        "connectors": [
          "general/imap",
          "inbound-email-monitor",
          "inbound_email",
          "inbound-email",
          "inbound"
        ]
      },
      "confirm_if_missing": true
    },
    {
      "name": "body",
      "required": true,
      "sources": [
        "upstream",
        "trigger"
      ],
      "description": "邮件正文；须来自上游步骤产出或入站 trigger，不得使用任务 NL 原文",
      "example_nl": "邮件正文使用上一步的结构化摘要",
      "propose_hint": "Do not paste task NL as body; prior llm-summarize / read / web-research step must feed this step.",
      "trigger_match": {
        "kinds": [
          "monitor",
          "file_arrival"
        ],
        "connectors": [
          "general/imap",
          "inbound-email-monitor",
          "inbound_email",
          "inbound-email",
          "inbound"
        ]
      },
      "confirm_if_missing": true
    },
    {
      "name": "subject",
      "required": false,
      "sources": [
        "upstream",
        "nl_fixed",
        "step_field",
        "default"
      ],
      "description": "邮件主题；缺省时可取上游输出首行",
      "confirm_if_missing": false
    }
  ],
  "auth": {
    "required": true,
    "binding_tool": "general/mail",
    "secret_kind": "smtp",
    "fields": [
      {
        "name": "host",
        "label": "Host",
        "type": "text",
        "required": true
      },
      {
        "name": "port",
        "label": "Port",
        "type": "number",
        "required": true,
        "default_value": "587"
      },
      {
        "name": "username",
        "label": "Username",
        "type": "text",
        "required": true
      },
      {
        "name": "password",
        "label": "Password",
        "type": "password",
        "required": true,
        "sensitive": true
      },
      {
        "name": "from",
        "label": "From",
        "type": "text",
        "required": true
      },
      {
        "name": "use_tls",
        "label": "Use STARTTLS (port 587)",
        "type": "checkbox",
        "default_value": "true",
        "required": false
      },
      {
        "name": "use_ssl",
        "label": "Use SSL (implicit TLS, port 465)",
        "type": "checkbox",
        "default_value": "false",
        "required": false
      }
    ],
    "sub_presets": [
      {
        "id": "gmail",
        "label": "Gmail",
        "defaults": {
          "host": "smtp.gmail.com",
          "port": "587",
          "use_tls": "true",
          "use_ssl": "false"
        },
        "note": "Password must be an app password."
      },
      {
        "id": "163",
        "label": "163",
        "defaults": {
          "host": "smtp.163.com",
          "port": "465",
          "use_tls": "false",
          "use_ssl": "true"
        },
        "note": "Password must be an authorization code; prefer 465 + SSL."
      },
      {
        "id": "custom",
        "label": "Custom",
        "defaults": {},
        "note": "Fill host / port yourself; 465 → Use SSL, 587 → Use STARTTLS."
      }
    ],
    "example_json": "{\"host\":\"smtp.gmail.com\",\"port\":587,\"username\":\"you@gmail.com\",\"password\":\"xxxx xxxx xxxx xxxx\",\"from\":\"you@gmail.com\",\"use_tls\":true,\"use_ssl\":false}"
  },
  "runtime": {
    "kind": "package",
    "entry": "runtime.invoke",
    "transport": "in_process",
    "timeout_ms": 30000,
    "idempotent": false
  },
  "invoke_tool": "general/mail",
  "binding_tool": "general/mail",
  "status": "stable",
  "trust": "first-party",
  "editable_governor_config": {
    "blocked_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Blocked keywords",
      "description": "Reject when content matches any listed substring (case-insensitive).",
      "default": []
    },
    "min_body_length": {
      "type": "integer",
      "minimum": 1,
      "label": "Minimum body length",
      "description": "Reject when trimmed body is shorter than this length."
    }
  }
}
