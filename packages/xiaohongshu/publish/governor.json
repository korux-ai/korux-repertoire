{
  "spec_version": "korux_governor_v1",
  "capability_id": "xiaohongshu/publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": ["title", "caption", "image_file_id", "image_url", "topics"]
  },
  "rules": [
    {
      "id": "block_empty_caption",
      "when": { "args.caption": { "empty": true } },
      "action": "reject",
      "code": "VALIDATION",
      "message": "Note caption is empty"
    },
    {
      "id": "block_denied_keywords",
      "when": { "args.caption": { "matches_any_owner": "blocked_keywords" } },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": "Caption contains a blocked keyword"
    },
    {
      "id": "require_human_by_default",
      "when": { "writes_external": true },
      "action": "intercept",
      "gate": "require_human",
      "message": "Xiaohongshu publish requires human approval"
    }
  ]
}
