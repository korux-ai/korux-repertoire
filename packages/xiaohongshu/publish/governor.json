{
  "spec_version": "korux_governor_v1",
  "capability_id": "xiaohongshu/publish",
  "capability_version": "1.0.0",
  "defaults": {
    "intercept_on_invoke": true,
    "editable_fields": [
      "title",
      "caption",
      "image_file_id",
      "image_url",
      "topics"
    ]
  },
  "rules": [
    {
      "id": "block_empty_caption",
      "when": {
        "args.caption": {
          "empty": true
        }
      },
      "action": "reject",
      "code": "VALIDATION",
      "message": {
        "en": "Note caption is empty",
        "zh_CN": "笔记文案为空",
        "zh_HK": "筆記文案為空"
      }
    },
    {
      "id": "block_denied_keywords",
      "when": {
        "args.caption": {
          "matches_any_owner": "blocked_keywords"
        }
      },
      "action": "reject",
      "code": "GOVERNOR_POLICY",
      "message": {
        "en": "Caption contains a blocked keyword",
        "zh_CN": "文案包含禁止关键字",
        "zh_HK": "文案包含禁止關鍵字"
      }
    },
    {
      "id": "require_human_by_default",
      "when": {
        "writes_external": true
      },
      "action": "intercept",
      "gate": "require_human",
      "message": {
        "en": "Xiaohongshu publish requires human approval",
        "zh_CN": "小红书发布前须人工确认",
        "zh_HK": "小紅書發佈前須人工確認"
      }
    }
  ],
  "implementation": "declarative",
  "notes": "Evaluated by Korux platform declarative engine; optional runtime/governor.py overrides."
}
